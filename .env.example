# Copy to .env.local for local development, and add the same names in
# Vercel (Project settings > Environment Variables). Never commit real values.

# Waitlist database: Neon's pooled connection string (the host has "-pooler").
DATABASE_URL=

# Long random string that scrambles IP addresses for the waitlist rate limit.
# Generate one with: openssl rand -hex 32
WAITLIST_SALT=

# Lets Vercel Cron call /api/cron/waitlist-purge. Generate it the same way.
CRON_SECRET=

# Public address once the real domain is chosen, e.g. https://example.in.
# Until it is set, robots.txt keeps search engines out.
NEXT_PUBLIC_SITE_URL=

# Comma-separated Google account IDs allowed to access the owner dashboard.
# Keep this server-only; do not expose it as a NEXT_PUBLIC_* variable.
OWNER_GOOGLE_IDS=

# Razorpay — add these when setting up payments.
# Key ID and secret from the Razorpay Dashboard (Settings > API Keys).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay webhook secret — from the Razorpay Dashboard (Webhooks > your webhook > Secret).
# Set NEXT_PUBLIC_RAZORPAY_KEY_ID once fan-side payment initiation is built.
RAZORPAY_WEBHOOK_SECRET=
